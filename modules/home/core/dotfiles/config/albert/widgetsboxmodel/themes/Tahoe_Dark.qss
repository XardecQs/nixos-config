/*
 * Albert Launcher Theme — macOS Tahoe (Clean Dark Mode)
 * Optimized for 1366x768 screens
 * Corrected colors and layered translucency
 */

* {
    border: none;
    color: #f2f2f7; /* Texto principal claro */
    background-color: transparent;
}

#frame {
    padding: 6px 16px 10px 16px;
    border-radius: 16px;

    /* Fondo oscuro cristalino */
    background-color: rgba(28, 28, 30, 0.9);

    /* Borde fino estilo cristal oscuro */
    border: 1px solid rgba(80, 80, 85, 0.9);

    /* Ancho adaptado para 1366x768 */
    min-width: 540px;
    max-width: 540px;
}

#inputLine {
    padding: 6px 14px 4px 14px;
    font-size: 28px;
    font-family: "SF Pro Display", ".AppleSystemUIFont", "Helvetica Neue", sans-serif;
    color: #f2f2f7;
    selection-color: #ffffff;
    selection-background-color: #007aff;
    background-color: transparent;
    border-bottom: 1px solid rgba(200, 200, 205, 0.15);
}

#settingsButton {
    margin: 8px 6px 0px 0px;
    color: rgba(200, 200, 205, 0.50);
    background-color: transparent;
    padding: 2px;
    min-width: 14px;
    min-height: 14px;
    max-width: 14px;
    max-height: 14px;
    border-radius: 4px;
}

#settingsButton:hover {
    background-color: rgba(200, 200, 205, 0.12);
    color: rgba(200, 200, 205, 0.90);
}

/********** ListViews ************/
QListView {
    background: transparent;
    selection-color: #ffffff;
    outline: none;
    padding: 4px 0px;
}

QListView::item {
    border-radius: 8px;
    margin: 1px 4px;
    color: #f2f2f7;
}

QListView::item:selected {
    /* Gradiente de selección azul macOS (más intenso para modo oscuro) */
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #0a84ff,
        stop:1 #007aff
    );
    border-radius: 8px;
    color: #ffffff;
}

QListView::item:hover:!selected {
    background-color: rgba(200, 200, 205, 0.08);
    border-radius: 8px;
}

/********** Scrollbar estilo Tahoe **********/
QListView QScrollBar:vertical {
    width: 3px;
    background: transparent;
    margin: 4px 0px;
}

QListView QScrollBar::handle:vertical {
    background: rgba(200, 200, 205, 0.35);
    border-radius: 1.5px;
    min-height: 24px;
}

QListView QScrollBar::handle:vertical:hover {
    background: rgba(200, 200, 205, 0.55);
}

QListView QScrollBar::add-line:vertical,
QListView QScrollBar::sub-line:vertical,
QListView QScrollBar::up-arrow:vertical,
QListView QScrollBar::down-arrow:vertical,
QListView QScrollBar::add-page:vertical,
QListView QScrollBar::sub-page:vertical {
    border: 0px;
    width: 0px;
    height: 0px;
    background: transparent;
}

/********** resultsList **********/
QListView#resultsList {
    icon-size: 32px;
    font-size: 18px;
    font-family: "SF Pro Text", ".AppleSystemUIFont", "Helvetica Neue", sans-serif;
}

QListView#resultsList::item {
    padding: 6px 6px 6px 6px;
    min-height: 38px;
}

/********** actionList **********/
QListView#actionList {
    font-size: 13px;
    font-family: "SF Pro Text", ".AppleSystemUIFont", "Helvetica Neue", sans-serif;
    background-color: rgba(40, 40, 42, 0.50); /* Un gris oscuro translúcido */
    border-top: 1px solid rgba(80, 80, 85, 0.4);
    border-radius: 0px 0px 14px 14px;
    padding: 4px 0px 4px 0px;
}

QListView#actionList::item {
    padding: 4px 6px;
    color: rgba(200, 200, 205, 0.85);
    border-radius: 6px;
    margin: 1px 4px;
}

QListView#actionList::item:selected {
    background: rgba(10, 132, 255, 0.18);
    color: #0a84ff;
}